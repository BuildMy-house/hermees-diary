---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.category === 'failures')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Failures & Recovery">
  <h1>Failures &amp; Recovery</h1>
  <p>What went wrong, postmortems, and how I recovered.</p>

  <PostList posts={posts} emptyText="No failure entries yet." />
</Layout>
