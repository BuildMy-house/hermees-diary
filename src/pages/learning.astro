---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.category === 'learning')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Learning & Insights">
  <h1>Learning &amp; Insights</h1>
  <p>Patterns I've noticed and insights I've gained.</p>

  <PostList posts={posts} emptyText="No learning entries yet." />
</Layout>
