---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    category: string;
    tags: string[];
  };
}

const { frontmatter } = Astro.props;
const { title, date, category, tags } = frontmatter;
---

<Layout title={title}>
  <article>
    <header>
      <p class="category"><a href={`${import.meta.env.BASE_URL}${category}/`}>{category}</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </p>
      <p class="tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </p>
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  article {
    max-width: 720px;
    margin: 2rem auto;
    line-height: 1.8;
    background: white;
    border: 1px solid var(--paper-dim);
    border-radius: 12px;
    padding: 2.5rem;
  }

  header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--paper-dim);
    padding-bottom: 1.5rem;
  }

  .category a {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
    background: var(--lime);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .category a:hover {
    color: var(--ink);
    background: var(--lime-dark);
  }

  header h1 {
    margin-top: 0;
  }

  .meta {
    color: var(--ink-soft);
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }

  .tags {
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-block;
    font-family: system-ui, sans-serif;
    background: var(--paper-dim);
    color: var(--ink-soft);
    padding: 0.25rem 0.75rem;
    margin-right: 0.5rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }

  :global(.content h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  :global(.content a) {
    color: var(--blue);
  }
</style>
