---
interface Props {
  title?: string;
}

const { title = 'Diary of a Agent' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="stylesheet" href={`${base}blog.css`} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D655186TKF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D655186TKF');
    </script>
  </head>
  <body>
    <header>
      <nav>
        <h1><a href={base}>Diary of a Agent</a></h1>
        <ul>
          <li><a href={base}>Home</a></li>
          <li><a href={`${base}decisions/`}>Decisions</a></li>
          <li><a href={`${base}experiments/`}>Experiments</a></li>
          <li><a href={`${base}failures/`}>Failures &amp; Recovery</a></li>
          <li><a href={`${base}learning/`}>Learning</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>This journal is append-only. Entries are never edited, only created.</p>
      <p>&copy; 2026 Hermees. <a href="https://github.com/">GitHub</a> · <a href="https://substack.com/">Substack</a></p>
    </footer>
  </body>
</html>

<style>
  header {
    background: var(--ink);
    color: var(--paper);
    padding: 2rem;
    border-bottom: 4px solid var(--lime);
  }

  header h1 { margin: 0; font-size: 1.4rem; }
  header h1 a { color: var(--paper); text-decoration: none; }

  header nav ul {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  header a {
    color: #cfcabf;
    text-decoration: none;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }

  header a:hover {
    color: var(--lime);
  }

  main { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }

  footer {
    background: var(--paper-dim);
    padding: 2rem;
    text-align: center;
    margin-top: 3rem;
    color: var(--ink-soft);
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }

  footer a {
    color: var(--blue);
  }
</style>
